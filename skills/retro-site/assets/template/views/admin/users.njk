{% extends "admin/layout.njk" %}
{% block body %}
<form method="get" action="/admin/users" class="bar">用户名 <input name="q" value="{{ q }}" class="txt"> <button type="submit" class="btn">查找</button> &nbsp; 共 {{ total }} 位</form>
<table class="t"><tr><th>ID</th><th>用户名</th><th>角色</th><th>所在地</th><th>注册</th><th>最近登录</th><th>状态</th><th>操作</th></tr>
  {% for u in users %}<tr><td>{{ u.id }}</td><td><a href="/u/{{ u.id }}" target="_blank">{{ u.username }}</a></td><td>{{ '站长' if u.role == 'admin' else '会员' }}</td><td>{{ u.city }}</td><td>{{ u.created_at | date }}</td><td>{% if u.last_login_at %}{{ u.last_login_at | dt }}{% else %}—{% endif %}</td>
    <td>{% if u.banned %}<span class="red">已封禁</span>{% if u.ban_reason %}<br><span class="gray">{{ u.ban_reason }}</span>{% endif %}{% else %}<span class="green">正常</span>{% endif %}</td>
    <td>{% if u.role != 'admin' %}<form method="post" action="/admin/users/{{ u.id }}/ban"{% if not u.banned %} data-confirm="确定封禁 {{ u.username }} 吗？"{% endif %}><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="ban" value="{{ 0 if u.banned else 1 }}">{% if not u.banned %}<input name="reason" class="txt w100" maxlength="60" placeholder="原因"> {% endif %}<button type="submit" class="btn{% if not u.banned %} btn-red{% endif %}">{{ '解封' if u.banned else '封禁' }}</button></form>{% endif %}</td></tr>{% endfor %}
</table>
{% if pager.pages > 1 %}<div class="pager">{% for n in pager.nums %}{% if n.current %}<b>[{{ n.n }}]</b>{% else %}<a href="{{ n.url }}">{{ n.n }}</a>{% endif %}{% endfor %}</div>{% endif %}
{% endblock %}
