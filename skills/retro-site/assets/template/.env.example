# 复制为 .env 后修改。带「必填」的上线前一定要改。

# 必填：站长账号，首次启动时自动创建
ADMIN_USERNAME=__ADMIN__
ADMIN_PASSWORD=请改成至少12位的强密码

# 必填：会话签名密钥，用 `openssl rand -hex 32` 生成；不填会自动生成并存在数据目录
SESSION_SECRET=

# 反向代理信任设置：本机直连用 loopback；容器前面有 Nginx 用 loopback,uniquelocal
TRUST_PROXY=loopback

# 首次启动是否导入演示数据（库里已有会员时自动跳过）
SEED_DEMO=false

# 访问日志
LOG_REQUESTS=true
