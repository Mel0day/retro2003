{% extends "layout.njk" %}
{% from "macros.njk" import pager as pagerLinks %}
{% block head %}<link rel="stylesheet" href="/static/css/forum.css?v={{ assetVersion }}">{% endblock %}
{% block body %}
<div class="col1">
  <div class="box red">
    <div class="box-hd"><span>▪ {{ board.name }}{% if category %} <span class="nb">（{{ category.name }}）</span>{% endif %}</span><span class="nb">主题 {{ board.thread_count }} · 帖子 {{ board.post_count }}</span></div>
    {% if board.description %}<div class="box-bd pink">{{ board.description }}</div>{% endif %}
  </div>

  <div class="forum-bar">
    <span>
      <a class="btn" href="/forum/board/{{ board.id }}/new" style="font-weight:bold">✎ 发表新主题</a>
      <a class="btn" href="/forum/board/{{ board.id }}/new?poll=1">发起投票</a>
    </span>
    {{ pagerLinks(pager) }}
  </div>

  <div class="box">
    <div class="tabs" style="padding-top:4px">
      <a href="/forum/board/{{ board.id }}"{% if not filter %} class="on"{% endif %}>全部主题</a>
      <a href="/forum/board/{{ board.id }}?filter=digest"{% if filter == 'digest' %} class="on"{% endif %}>精华区</a>
    </div>
    <table class="tbl" style="border:0">
      <tr><th style="width:30px"></th><th>标题</th><th>作者</th><th>回复/查看</th><th>最后发表</th></tr>
      {% for t in threads %}
      <tr>
        <td class="num">{% if t.locked %}<span class="tflag locked" title="已锁定">锁</span>{% elif t.hot %}<span class="tflag hot" title="热门">热</span>{% else %}<span class="gray">·</span>{% endif %}</td>
        <td class="t"><div class="ellipsis">
          {% if t.sticky %}<span class="tflag sticky">[置顶]</span> {% endif %}
          {% if t.is_poll %}<span class="tflag poll">[投票]</span> {% endif %}
          <a href="/forum/thread/{{ t.id }}" title="{{ t.title }}"{% if t.sticky %} class="b"{% endif %}>{{ t.title }}</a>
          {% if t.digest %} <span class="tflag digest">[精华]</span>{% endif %}
          {% if t.isNew %} <span class="new">NEW</span>{% endif %}
        </div></td>
        <td class="nowrap" style="line-height:1.3"><a href="/u/{{ t.user_id }}">{{ t.username }}</a><br><span class="gray tiny verdana">{{ t.created_at | date }}</span></td>
        <td class="num">{{ t.reply_count }} / {{ t.hits }}</td>
        <td class="nowrap" style="line-height:1.3"><span class="gray tiny verdana">{{ t.last_post_at | dt }}</span><br>by {{ t.last_username or t.username }}</td>
      </tr>
      {% else %}
      <tr><td colspan="5" class="box-empty">{% if filter %}本版暂无精华主题{% else %}本版还没有主题，<a href="/forum/board/{{ board.id }}/new">快来发表第一帖</a>！{% endif %}</td></tr>
      {% endfor %}
    </table>
  </div>

  <div class="forum-bar">
    <span><a class="btn" href="/forum/board/{{ board.id }}/new">✎ 发表新主题</a> <a href="/forum">返回论坛首页</a></span>
    {{ pagerLinks(pager) }}
  </div>
</div>
{% endblock %}
