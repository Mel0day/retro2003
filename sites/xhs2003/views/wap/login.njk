{% extends "wap/layout.njk" %}
{% from "wap/macros.njk" import captcha %}
{% block body %}
<div class="crumb"><a href="/wap">首页</a> &gt; 会员登录</div>
{% if error %}<div class="err">✘ {{ error }}</div>{% endif %}
<form class="form" method="post" action="/wap/login">
  <input type="hidden" name="_csrf" value="{{ csrf }}">
  <input type="hidden" name="next" value="{{ next }}">
  <label>用户名：<br><input class="ipt full" name="username" value="{{ username or '' }}" maxlength="16" required autocomplete="username"></label>
  <label>密码：<br><input class="ipt full" type="password" name="password" maxlength="32" required autocomplete="current-password"></label>
  {% if needCaptcha %}<label>验证码：<input class="ipt w48" name="captcha" maxlength="4" autocomplete="off" required> {{ captcha() }}</label>{% endif %}
  <label><input type="checkbox" name="remember" value="1"> 两周内免登录</label>
  <div><button class="btn" type="submit">登 录</button></div>
</form>
<div class="small sep">还没有账号？<a href="/wap/register" accesskey="1">[1] 免费注册</a></div>
{% endblock %}
{% block bottom %}<div class="small"><b>[0]</b> <a href="/wap" accesskey="0">首页</a></div>{% endblock %}
