{% extends "wap/layout.njk" %}
{% from "wap/macros.njk" import pager as pg %}
{% block body %}
<div class="crumb"><a href="/wap">首页</a> &gt; <a href="/wap/my">我的</a> &gt; 短消息</div>
{% for m in list %}
<div class="item line">{% if not m.read_at %}<span class="red xs">[未读]</span>{% endif %} <a href="/wap/pm/{{ m.id }}">{{ m.title }}</a> <span class="tiny gray8">{{ m.from_name or '系统消息' }} {{ m.created_at | md }}</span></div>
{% else %}
<div class="gray small">收件箱是空的。</div>
{% endfor %}
{{ pg(pager) }}
<div class="xs gray sep">写短消息请用电脑版。</div>
{% endblock %}
{% block bottom %}<div class="small"><b>[0]</b> <a href="/wap" accesskey="0">首页</a></div>{% endblock %}
