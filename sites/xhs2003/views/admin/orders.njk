{% extends "admin/layout.njk" %}
{% from "macros.njk" import pager as pagerLinks %}
{% block head %}<link rel="stylesheet" href="/static/css/shop.css?v={{ assetVersion }}">{% endblock %}
{% block body %}
<div class="box">
  <div class="box-hd"><span>▪ 订单管理</span><span class="nb">共 {{ pager.total }} 个</span></div>
  <div class="tabs">
    <a href="/admin/orders"{% if not status %} class="on"{% endif %}>全部</a>
    {% for key, label in statusLabels %}<a href="/admin/orders?status={{ key }}"{% if status == key %} class="on"{% endif %}>{{ label }}{% if counts[key] %}({{ counts[key] }}){% endif %}</a>{% endfor %}
  </div>
  <form class="admin-toolbar" method="get" action="/admin/orders">
    {% if status %}<input type="hidden" name="status" value="{{ status }}">{% endif %}
    <input class="ipt w200" name="q" value="{{ q }}" placeholder="订单号 / 收货人 / 电话 / 用户名">
    <button class="btn" type="submit">搜索</button>
  </form>
  <table class="tbl">
    <tr><th>订单号</th><th>买家</th><th>商品</th><th>数量</th><th>金额</th><th>付款</th><th>收货人</th><th>状态</th><th>下单时间</th><th>操作</th></tr>
    {% for o in orders %}
    <tr>
      <td class="num"><a href="/admin/orders/{{ o.order_no }}">{{ o.order_no }}</a></td>
      <td class="nowrap"><a href="/u/{{ o.user_id }}" target="_blank">{{ o.username }}</a></td>
      <td class="t"><div class="ellipsis" title="{{ o.product_name }}">{{ o.product_name }}</div></td>
      <td class="num">{{ o.qty }}</td>
      <td class="num"><b class="red">¥{{ o.total_cents | yuan }}</b></td>
      <td class="nowrap">{{ paymentLabels[o.payment] }}</td>
      <td class="nowrap">{{ o.receiver }}</td>
      <td class="nowrap"><span class="status-{{ o.status }}">{{ statusLabels[o.status] }}</span></td>
      <td class="num gray">{{ o.created_at | dt }}</td>
      <td class="acts"><a href="/admin/orders/{{ o.order_no }}">[处理]</a></td>
    </tr>
    {% else %}
    <tr><td colspan="10" class="box-empty">没有订单</td></tr>
    {% endfor %}
  </table>
  {{ pagerLinks(pager) }}
</div>
{% endblock %}
