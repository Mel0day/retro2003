{% extends "admin/layout.njk" %}
{% from "macros.njk" import pager as pagerLinks %}
{% block body %}
<div class="box">
  <div class="box-hd"><span>▪ 笔记管理</span><span class="nb">共 {{ pager.total }} 篇</span></div>
  <form method="get" action="/admin/notes" class="admin-toolbar">
    标题：<input class="ipt w120" name="q" value="{{ filters.q }}" maxlength="50">
    <select class="sel" name="channel"><option value="">全部频道</option>{% for c in channels %}<option value="{{ c.id }}"{% if filters.channel == c.id %} selected{% endif %}>{{ c.name }}</option>{% endfor %}</select>
    <select class="sel" name="status"><option value="">全部状态</option><option value="published"{% if filters.status == 'published' %} selected{% endif %}>正常</option><option value="hidden"{% if filters.status == 'hidden' %} selected{% endif %}>已隐藏</option></select>
    <select class="sel" name="featured"><option value="">推荐不限</option><option value="1"{% if filters.featured == '1' %} selected{% endif %}>已推荐</option><option value="0"{% if filters.featured == '0' %} selected{% endif %}>未推荐</option></select>
    <button class="btn" type="submit">筛选</button> <a href="/admin/notes">清除</a>
  </form>
  <form method="post" action="/admin/notes/batch" id="batch-form">
    <input type="hidden" name="_csrf" value="{{ csrf }}">
    <input type="hidden" name="back" value="{{ url }}">
  </form>
  <table class="tbl" style="border:0">
    <tr><th style="width:20px"><input type="checkbox" class="chk" data-check-all="ids"></th><th>标题</th><th>频道</th><th>作者</th><th>点击/回复</th><th>状态</th><th>发表时间</th><th>操作</th></tr>
    {% for n in list %}
    <tr>
      <td class="num"><input type="checkbox" class="chk" name="ids" value="{{ n.id }}" form="batch-form"></td>
      <td class="t"><div class="ellipsis"><span class="red small">{% if n.has_image %}[图]{% else %}[文]{% endif %}</span> <a href="/notes/{{ n.id }}" target="_blank" title="{{ n.title }}">{{ n.title }}</a>{% if n.featured %} <span class="red b small">[荐]</span>{% endif %}</div></td>
      <td class="nowrap gray6">{{ n.channel_name }}</td>
      <td class="nowrap"><a href="/u/{{ n.user_id }}" target="_blank" class="gray6">{{ n.username }}</a></td>
      <td class="num">{{ n.hits }}/{{ n.comment_count }}</td>
      <td class="num">{% if n.status == 'published' %}<span class="green">正常</span>{% else %}<span class="gray">已隐藏</span>{% endif %}</td>
      <td class="num gray">{{ n.created_at | dt }}</td>
      <td class="acts">
        <form method="post" action="/admin/notes/{{ n.id }}/{{ 'unfeature' if n.featured else 'feature' }}"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="back" value="{{ url }}"><button class="btn sm" type="submit">{{ '取消推荐' if n.featured else '推荐' }}</button></form>
        <form method="post" action="/admin/notes/{{ n.id }}/{{ 'hide' if n.status == 'published' else 'restore' }}"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="back" value="{{ url }}"><button class="btn sm" type="submit">{{ '隐藏' if n.status == 'published' else '恢复' }}</button></form>
        <form method="post" action="/admin/notes/{{ n.id }}/delete" data-confirm="确定要删除《{{ n.title }}》吗？删除后不能恢复！"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="back" value="{{ url }}"><button class="btn sm" type="submit">删除</button></form>
      </td>
    </tr>
    {% else %}
    <tr><td colspan="8" class="box-empty">没有符合条件的笔记</td></tr>
    {% endfor %}
  </table>
  <div class="flex-between" style="padding:4px 8px">
    <span class="flex">选中项：
      <select class="sel" name="action" form="batch-form">
        <option value="">-- 批量操作 --</option><option value="feature">设为推荐</option><option value="unfeature">取消推荐</option>
        <option value="hide">隐藏</option><option value="restore">恢复显示</option><option value="delete">删除</option>
      </select>
      <button class="btn" type="submit" form="batch-form" data-confirm="确定对选中的笔记执行该操作吗？">执行</button>
    </span>
    {{ pagerLinks(pager) }}
  </div>
</div>
{% endblock %}
{% block scripts %}<script src="/static/js/admin.js?v={{ assetVersion }}"></script>{% endblock %}
