# 复制为 .env 后修改。带「必填」的上线前一定要改。

# 必填：站长账号，首次启动时自动创建（之后修改这里不会改已有账号的密码）
ADMIN_USERNAME=站长
ADMIN_PASSWORD=请改成至少12位的强密码

# 必填：会话签名密钥，用 `openssl rand -hex 32` 生成；不填会自动生成并保存在数据目录
SESSION_SECRET=

# 反向代理信任设置：同机 Nginx 用 loopback；Docker 容器前面有 Nginx 用 loopback,uniquelocal
TRUST_PROXY=loopback,uniquelocal

# 首次启动是否导入演示数据（数据库里已有笔记时自动跳过）
SEED_DEMO=false

# 宿主机映射端口（docker compose 使用）
XHS_PORT=3003

# 访问日志
LOG_REQUESTS=true

# 构建镜像时使用的 npm 源，国内服务器可改为 https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmjs.org
