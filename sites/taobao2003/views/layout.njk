<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>{% if title %}{{ title }} - {% endif %}淘宝网 - 淘！我喜欢</title>
<link rel="stylesheet" href="/static/css/fonts.css?v={{ assetVersion }}">
<link rel="stylesheet" href="/static/css/site.css?v={{ assetVersion }}">
{% block head %}{% endblock %}
</head>
<body data-csrf="{{ csrf }}">
<div class="wrap">
<table class="frame" cellpadding="0" cellspacing="0">
  <tr><td class="topbar">
    <span>{% if user %}您好，<a href="/my" class="uname">{{ user.username }}</a>！ <form method="post" action="/logout" class="inline"><input type="hidden" name="_csrf" value="{{ csrf }}"><button type="submit" class="linkbtn">[退出]</button></form>{% if isAdmin %} <a href="/admin">[小二后台]</a>{% endif %}{% else %}您好，欢迎来淘宝！ <a href="/login?next={{ here | urlencode }}">[请登录]</a> <a href="/register?next={{ here | urlencode }}">[免费注册]</a>{% endif %}</span>
    <span><a href="/cart">我的购物车({{ cartCount }})</a> | <a href="/my">我的淘宝</a> | <a href="/sell" class="sell">我要卖</a> | <a href="/" data-action="fav">收藏本站</a> | <a href="/page/help">帮助中心</a></span>
  </td></tr>
  <tr><td class="header">
    <table cellpadding="0" cellspacing="0" class="full"><tr>
      <td class="logocell"><a href="/" class="logolink"><span class="logo">淘宝网</span></a><div class="slogan">淘！我喜欢</div></td>
      <td class="searchcell">
        <form method="get" action="/" class="search">
          <select name="cat" aria-label="宝贝分类"><option value="all">全部宝贝</option>{% for c in CATS %}<option value="{{ c }}"{% if cat == c %} selected{% endif %}>{{ c }}</option>{% endfor %}</select>
          <input name="q" value="{{ q }}" placeholder="输入宝贝名称，如：MP3" maxlength="40" aria-label="关键词">
          <button type="submit">搜 索</button>
        </form>
        <div class="hot">热门：{% for w in hotWords %}<a href="/?q={{ w | urlencode }}">{{ w }}</a> {% endfor %}</div>
      </td>
      <td class="online">今日在线宝贝<br><b>{{ onsaleCount | thousands }}</b> 件</td>
    </tr></table>
  </td></tr>
  <tr><td class="nav">
    <a href="/"{% if nav == 'home' %} class="on"{% endif %}>首页</a>
    {% for c in CATS %}<a href="/?cat={{ c | urlencode }}"{% if nav == c %} class="on"{% endif %}>{{ c }}</a>{% endfor %}
    <a href="/cart"{% if nav == 'cart' %} class="on"{% endif %}>购物车</a>
    <a href="/my/bought"{% if nav == 'orders' %} class="on"{% endif %}>我的订单</a>
  </td></tr>
  <tr><td class="marquee"><div>{{ site.announcement }}</div></td></tr>
  <tr><td class="crumb">所在位置：<a href="/">淘宝网</a>{% for c in crumbs %} &gt; {% if c.url %}<a href="{{ c.url }}">{{ c.text }}</a>{% else %}{{ c.text }}{% endif %}{% endfor %}</td></tr>
  <tr><td class="content">
{% block body %}{% endblock %}
  </td></tr>
  <tr><td class="footer">
    <a href="/page/about">关于淘宝</a> | <a href="/page/jobs">诚聘英才</a> | <a href="/page/contact">联系我们</a> | <a href="/page/safe">安全交易</a> | <a href="/page/alipay">支付宝</a> | <a href="/page/sitemap">网站地图</a><br>
    Copyright © 2003 淘宝网 Taobao.com 版权所有 &nbsp; {% if site.icp %}{{ site.icp }} &nbsp; {% endif %}推荐 IE5.5 以上 1024×768 浏览<br>
    客服信箱：{{ site.service_email }} &nbsp; <span class="counter">访问量 {{ visitorsShown }}</span>
  </td></tr>
</table>
</div>
<script src="/static/js/site.js?v={{ assetVersion }}"></script>
</body>
</html>
