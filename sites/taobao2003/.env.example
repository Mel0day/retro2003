# 复制为 .env 后修改。带「必填」的上线前一定要改。

# 必填：淘宝小二（站长）账号，首次启动时自动创建（之后改这里不会改已有账号的密码）
ADMIN_USERNAME=淘宝小二
ADMIN_PASSWORD=请改成至少12位的强密码

# 必填：会话签名密钥，用 `openssl rand -hex 32` 生成；不填会自动生成并保存在数据目录
SESSION_SECRET=

# 反向代理信任设置：同机 Nginx 用 loopback；容器前面有 Nginx 用 loopback,uniquelocal；
# 走 Cloudflare Tunnel 时只写隧道连接器的固定地址（见 deploy/cloudflare/README.md）
TRUST_PROXY=loopback

# 首次启动是否导入演示数据（库里已有会员时自动跳过）
SEED_DEMO=false

# 新会员注册赠送的支付宝体验金（元，演示用虚拟资金）
NEW_MEMBER_YUAN=1000

# 卖家发货后多少天买家不确认收货，系统自动确认
AUTO_CONFIRM_DAYS=10

# 宿主机映射端口（docker compose 使用）
TAOBAO_PORT=3004

# 访问日志
LOG_REQUESTS=true

# 构建镜像时使用的 npm 源，国内服务器可改为 https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmjs.org
